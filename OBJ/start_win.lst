 713          win_pass_keypad_btn_click_handler
 714          函数功能：后台密码数字键盘处理函数
 715          *********************************************************/
 716          static void win_pass_keypad_btn_click_handler(u16 btn_val)
 717          {
 718   1        u16 xdata temp;
 719   1        temp = win_str_data.passcode;
 720   1        if(btn_val == 12)   //弹窗后 还原时间
 721   1        {
 722   2          win_str_data.used_time_h = 0;
 723   2          win_str_data.used_time_l = 0;
 724   2      
 725   2          norflash_write(RUNTIME_MIN_HADDR,(u8 *)&win_str_data.used_time_h,2);
 726   2      
 727   2          win_str_data.used_time = win_str_data.used_time_h;
 728   2          win_str_data.used_time <<= 16;
 729   2          win_str_data.used_time |= win_str_data.used_time_l;
 730   2          win_str_data.disp_time = win_str_data.used_time/3600;  //小时数
 731   2        
 732   2          sys_write_vp(ARTNUM_UT_ADDR,(u8*)&win_str_data.disp_time,1);   //总运行时间清零
 733   2          win_str_data.passcode = 0;
 734   2            
 735   2          win_change_page(SET_PAGE);
 736   2      
 737   2        }
 738   1        if(btn_val == 13)   //X
 739   1        {
 740   2          win_change_page(SET_PAGE);
 741   2        }
 742   1        else if(btn_val < 11)
 743   1        {
 744   2          if(btn_val == 10) btn_val =0;
 745   2          temp = temp%1000;
 746   2          temp = temp*10;
 747   2          temp +=btn_val;
 748   2          if(temp>9999) temp = 9999;
 749   2          else if(temp <0) temp = 0;
 750   2          win_str_data.passcode = temp;
 751   2          sys_write_vp(ARTNUM_PASSCODE_ADDR,(u8*)&win_str_data.passcode,1);       
 752   2        }
 753   1        else
 754   1        {
 755   2          temp= temp/10;
 756   2          if(temp <0) temp=0;
 757   2          win_str_data.passcode = temp;
 758   2          sys_write_vp(ARTNUM_PASSCODE_ADDR,(u8*)&win_str_data.passcode,1);     
 759   2        }
 760   1        if(temp == 1010)            //复位密码
 761   1        {
 762   2          win_str_data.passcode = 0;
 763   2          sys_write_vp(ARTNUM_PASSCODE_ADDR,(u8*)&win_str_data.passcode,1);
 764   2          win_change_page(RESET_PAGE);
 765   2        }
 766   1        else if(temp == 5973)      //后台密码
