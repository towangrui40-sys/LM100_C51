 131          static void win_calc_function(void)
 132          {
 133   1        float xdata temp,temp1;
 134   1        STR_WIN_TypeDef *obj = &win_str_data; 
 135   1        temp = product_data[obj->product_id].vol_max-product_data[obj->product_id].vol_min;
 136   1        temp1 = product_data[obj->product_id].para1.max-product_data[obj->product_id].para1.min;
 137   1        obj->k_factor = temp/temp1;
 138   1        
 139   1        temp = obj->k_factor*product_data[obj->product_id].para1.min;
 140   1        obj->b_factor = product_data[obj->product_id].vol_min-temp;
 141   1      }
