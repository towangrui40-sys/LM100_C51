 183          static void win_load_setpara(void)
 184          {
 185   1        //1.load startup logo
 186   1        if(win_str_data.logo >0) win_str_data.logo = 4;
 187   1        sys_write_vp(ANIMOTION_LOGO_ADDR,(u8*)&win_str_data.logo,2);  //no logo for oem
 188   1      
 189   1        if(win_str_data.light>100) win_str_data.light = 100;
 190   1        if(win_str_data.light<10) win_str_data.light = 10;
 191   1        sys_setdis_light(win_str_data.light);
 192   1        sys_write_vp(BTN_SET_LIGHT_ADDR,(u8*)&win_str_data.light,1);  
 193   1      
 194   1        if(win_str_data.alarm > 1) win_str_data.alarm = 1;
 195   1        if(win_str_data.alarm < 0) win_str_data.alarm = 0;
 196   1        sys_enable_speaker(1-win_str_data.alarm);   
 197   1        sys_write_vp(BTN_SET_BUZZ_ADDR,(u8*)&win_str_data.alarm,1);
 198   1        
 199   1        if(win_str_data.language >= 3) win_str_data.language = 3;
 200   1        if(win_str_data.language <= 0) win_str_data.language = 0; 
 201   1        sys_write_vp(BTN_LANGUAGE_ADDR,(u8*)&win_str_data.language,1);
 202   1        
 203   1        if(win_str_data.medium_flag < 1 || win_str_data.medium_flag > 2) win_str_data.medium_flag = 1;
 204   1      
 205   1      }
