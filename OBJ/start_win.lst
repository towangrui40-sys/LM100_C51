 374          static void win_prog_num_sel_btn_click_handler(u16 btn_val)
 375          {
 376   1        switch(btn_val)
 377   1        {
 378   2          case BTN_VAL_ACC:
 379   2              if(win_str_data.prog_grp < 20) win_str_data.prog_grp++; 
 380   2            break;
 381   2          case BTN_VAL_DEC:
 382   2              if(win_str_data.prog_grp > 1) win_str_data.prog_grp--;  
 383   2            break;
 384   2          default:break;
 385   2        }
 386   1        sys_write_vp(ARTNUM_MAIN_PROG_NUM_ADDR,(u8*)&win_str_data.prog_grp,1);  
