 134          static void win_calc_function(void)
 135          {
 136   1        float xdata temp,temp1;
 137   1        STR_WIN_TypeDef *obj = &win_str_data; 
 138   1        temp = product_data[obj->product_id].vol_max-product_data[obj->product_id].vol_min;
 139   1        temp1 = product_data[obj->product_id].para1.max-product_data[obj->product_id].para1.min;
 140   1        obj->k_factor = temp/temp1;
 141   1        
 142   1        temp = obj->k_factor*product_data[obj->product_id].para1.min;
 143   1        obj->b_factor = product_data[obj->product_id].vol_min-temp;
 144   1      }
