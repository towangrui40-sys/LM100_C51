 186          static void win_load_setpara(void)
 187          {
 188   1        //1.load startup logo
 189   1        if(win_str_data.logo >0) win_str_data.logo = 4;
 190   1        sys_write_vp(ANIMOTION_LOGO_ADDR,(u8*)&win_str_data.logo,2);  //no logo for oem
 191   1      
 192   1        if(win_str_data.light>100) win_str_data.light = 100;
 193   1        if(win_str_data.light<10) win_str_data.light = 10;
 194   1        sys_setdis_light(win_str_data.light);
 195   1        sys_write_vp(BTN_SET_LIGHT_ADDR,(u8*)&win_str_data.light,1);  
 196   1      
 197   1        if(win_str_data.alarm > 1) win_str_data.alarm = 1;
 198   1        if(win_str_data.alarm < 0) win_str_data.alarm = 0;
 199   1        sys_enable_speaker(1-win_str_data.alarm);   
 200   1        sys_write_vp(BTN_SET_BUZZ_ADDR,(u8*)&win_str_data.alarm,1);
 201   1        
 202   1        if(win_str_data.language >= 3) win_str_data.language = 3;
 203   1        if(win_str_data.language <= 0) win_str_data.language = 0; 
 204   1        sys_write_vp(BTN_LANGUAGE_ADDR,(u8*)&win_str_data.language,1);
 205   1        
 206   1        if(win_str_data.medium_flag < 1 || win_str_data.medium_flag > 2) win_str_data.medium_flag = 1;
 207   1      
 208   1      }
