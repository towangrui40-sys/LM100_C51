C51 COMPILER V9.60.7.0   START_WIN                                                         10/19/2026 10:20:12 PAGE 13  

 711          static void win_pass_keypad_btn_click_handler(u16 btn_val)
 712          {
 713   1        u16 xdata temp;
 714   1        temp = win_str_data.passcode;
 715   1        if(btn_val == 12)   //弹窗后 还原时间
 716   1        {
 717   2          win_str_data.used_time_h = 0;
 718   2          win_str_data.used_time_l = 0;
 719   2      
 720   2          norflash_write(RUNTIME_MIN_HADDR,(u8 *)&win_str_data.used_time_h,2);
 721   2      
 722   2          win_str_data.used_time = win_str_data.used_time_h;
 723   2          win_str_data.used_time <<= 16;
 724   2          win_str_data.used_time |= win_str_data.used_time_l;
 725   2          win_str_data.disp_time = win_str_data.used_time/3600;  //小时数
 726   2        
 727   2          sys_write_vp(ARTNUM_UT_ADDR,(u8*)&win_str_data.disp_time,1);   //总运行时间清零
 728   2          win_str_data.passcode = 0;
 729   2            
 730   2          win_change_page(SET_PAGE);
 731   2      
 732   2        }
 733   1        if(btn_val == 13)   //X
 734   1        {
 735   2          win_change_page(SET_PAGE);
 736   2        }
 737   1        else if(btn_val < 11)
 738   1        {
 739   2          if(btn_val == 10) btn_val =0;
 740   2          temp = temp%1000;
 741   2          temp = temp*10;
 742   2          temp +=btn_val;
 743   2          if(temp>9999) temp = 9999;
 744   2          else if(temp <0) temp = 0;
 745   2          win_str_data.passcode = temp;
 746   2          sys_write_vp(ARTNUM_PASSCODE_ADDR,(u8*)&win_str_data.passcode,1);       
 747   2        }
 748   1        else
 749   1        {
 750   2          temp= temp/10;
 751   2          if(temp <0) temp=0;
 752   2          win_str_data.passcode = temp;
 753   2          sys_write_vp(ARTNUM_PASSCODE_ADDR,(u8*)&win_str_data.passcode,1);     
 754   2        }
 755   1        if(temp == 1010)            //复位密码
 756   1        {
 757   2          win_str_data.passcode = 0;
 758   2          sys_write_vp(ARTNUM_PASSCODE_ADDR,(u8*)&win_str_data.passcode,1);
 759   2          win_change_page(RESET_PAGE);
 760   2        }
