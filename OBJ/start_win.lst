 371          static void win_prog_num_sel_btn_click_handler(u16 btn_val)
 372          {
 373   1        switch(btn_val)
 374   1        {
 375   2          case BTN_VAL_ACC:
 376   2              if(win_str_data.prog_grp < 20) win_str_data.prog_grp++; 
 377   2            break;
 378   2          case BTN_VAL_DEC:
 379   2              if(win_str_data.prog_grp > 1) win_str_data.prog_grp--;  
 380   2            break;
 381   2          default:break;
 382   2        }
 383   1      
