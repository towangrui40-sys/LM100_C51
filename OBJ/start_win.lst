 388   1        
 389   1        win_load_prog_paras(PROG_COOLING_TIME_OFFSET,(u8 *)&win_str_data.set_cooling_time,6);
 390   1        win_disp_cooling_time(win_str_data.set_cooling_time);
 391   1        win_disp_volume(win_str_data.set_volume);
 392   1        win_disp_temp(win_str_data.set_grind_temp);
 393   1        win_disp_speed(win_str_data.set_grind_speed);
 394   1        win_disp_grind_time(win_str_data.set_grind_time);
 395   1      }
